{
  "expo": {
    "name": "Hatua",
    "slug": "hatua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hatua-icon.png",
    "scheme": "hatua",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/hatua-adaptive.png",
        "backgroundColor": "#D8E6F7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hatua.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D8E6F7",
          "image": "./assets/images/hatua-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hatua uses the camera so you can add proof of your progress."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
